---
// Omdirigering för en adress som har flyttat. Sajten ligger på GitHub Pages, som
// inte kan skicka riktiga omdirigeringar, så det görs med en meta-tagg.
interface Props {
	to: string
}
const { to } = Astro.props
const canonical = new URL(to, Astro.site)
---

<!doctype html>
<html lang="sv">
	<head>
		<meta charset="utf-8" />
		<title>Sidan har flyttat</title>
		<meta http-equiv="refresh" content={`0;url=${to}`} />
		<meta name="robots" content="noindex" />
		<link rel="canonical" href={canonical.href} />
	</head>
	<body>
		<p>Sidan har flyttat till <a href={to}>{canonical.href}</a>.</p>
	</body>
</html>
