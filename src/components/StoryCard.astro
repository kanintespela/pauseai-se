---
import type { CollectionEntry } from 'astro:content'
import { excerpt, imageUrl, url } from '../lib'

interface Props {
	story: CollectionEntry<'berattelser'>
}
const { story } = Astro.props
const { namn, ort, bild } = story.data
const text = excerpt(story.body, 260)
const hasMore = text.endsWith('…') || (story.body ?? '').trim().split(/\n\s*\n/).length > 1
---

<article class="story">
	<blockquote>”{text}”</blockquote>
	<footer>
		{bild ? <img src={imageUrl(bild)} alt="" loading="lazy" /> : <span class="initial" aria-hidden="true">{namn.charAt(0)}</span>}
		<span>
			<strong>{namn}</strong>
			{ort && <span class="muted">{ort}</span>}
		</span>
	</footer>
	{hasMore && <a href={url(`/berattelser/${story.id}`)}>Läs hela →</a>}
</article>

<style>
	.story {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		padding: 1.5rem;
		background: var(--bg-alt);
		border-top: 6px solid var(--brand);
	}
	blockquote {
		margin: 0;
		padding: 0;
		border: 0;
		background: none;
		font-size: 1.05rem;
	}
	footer {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-top: auto;
	}
	footer > span {
		display: flex;
		flex-direction: column;
		line-height: 1.3;
	}
	img,
	.initial {
		flex: none;
		width: 3rem;
		height: 3rem;
		border-radius: 50%;
		object-fit: cover;
	}
	.initial {
		display: grid;
		place-items: center;
		padding-top: 0.15em;
		line-height: 1;
		background: var(--brand);
		color: #000;
		font-family: var(--font-heading);
		font-size: 1.5rem;
		font-weight: 700;
	}
	a {
		font-weight: 700;
	}
</style>
