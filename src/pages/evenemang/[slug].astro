---
import { getCollection, render } from 'astro:content'
import Base from '../../layouts/Base.astro'
import { formatDateTime, isUpcoming, url, whatsappLink } from '../../lib'

export async function getStaticPaths() {
	const events = await getCollection('evenemang')
	return events.map((event) => ({ params: { slug: event.id }, props: { event } }))
}

const { event } = Astro.props
const { Content } = await render(event)
const upcoming = isUpcoming(event.data.date)
const pageUrl = new URL(url(`/evenemang/${event.id}`), Astro.site).href
const whatsapp = whatsappLink({ id: event.id, ...event.data, pageUrl })
---

<Base title={event.data.title} description={event.data.description}>
	<article class="container prose">
		<p class="muted"><a href={url('/evenemang')}>Evenemang</a></p>
		<h1>{event.data.title}</h1>
		{!upcoming && <p class="muted"><strong>Det här evenemanget har redan ägt rum.</strong></p>}
		<dl>
			<dt>När</dt>
			<dd><time datetime={event.data.date.toISOString()}>{formatDateTime(event.data.date)}</time></dd>
			<dt>Var</dt>
			<dd>{event.data.location}</dd>
		</dl>
		<Content />
		{upcoming && event.data.link && <p><a class="button" href={event.data.link}>Anmälan och mer info</a></p>}
		{
			upcoming && (
				<p class="share">
					<a class="button secondary" href={whatsapp}>Dela i WhatsApp</a>
					<a class="button secondary" href={url(`/evenemang/${event.id}.ics`)} download>
						Lägg till i kalendern
					</a>
				</p>
			)
		}
	</article>
</Base>

<style>
	dl {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 0.25rem 1rem;
		padding: 1rem;
		background: var(--bg-alt);
		border-left: 4px solid var(--brand);
	}
	dt {
		font-weight: 700;
	}
	dd {
		margin: 0;
	}
	.share {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}
</style>
